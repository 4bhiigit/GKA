# ============================================================
# GitHub Knowledge Assistant (GKA) - Environment Configuration
# ============================================================

# Backend Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration
# Local SQLite (zero-config, default): "file:./dev.db"
# Docker PostgreSQL: "postgresql://gka_user:gka_password@localhost:5432/gka_db?schema=public"
DATABASE_URL="file:./dev.db"

# LLM Providers (Free Tier)
# Get free Groq API key: https://console.groq.com/
GROQ_API_KEY=""
# Get free Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=""

# Preferred LLM for Chat (groq | gemini)
DEFAULT_LLM_PROVIDER=groq
# Preferred LLM model (e.g., llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b, gemini-2.0-flash, gemini-1.5-flash)
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# Embeddings Configuration (gemini | local)
EMBEDDING_PROVIDER=gemini
# Gemini embedding model
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Vector Store Engine (embedded | qdrant)
# "embedded": Fast local persistent vector store (zero external dependencies)
# "qdrant": Self-hosted Qdrant docker instance or Qdrant Cloud
VECTOR_STORE_TYPE=embedded
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# GitHub API & OAuth App (Optional - For GitHub Login & private repo access)
# Create OAuth app at: https://github.com/settings/developers
GITHUB_TOKEN=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Redis Cache & Queue (Optional if running Docker)
REDIS_URL=redis://localhost:6379

# Indexing Limits
MAX_FILES_PER_REPO=250
MAX_FILE_SIZE_BYTES=300000
